{
  "name": "debatr",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "postinstall": "prisma generate",
    "build": "prisma generate && next build --webpack",
    "build:railway": "npx prisma generate && next build --webpack && cp -r .next/static .next/standalone/.next/ && cp -r public .next/standalone/",
    "start": "npx prisma generate && npx prisma migrate deploy && next build --webpack && next start -p $PORT",
    "start:railway": "npx prisma migrate deploy && PORT=$PORT HOSTNAME=0.0.0.0 node .next/standalone/server.js",
    "lint": "eslint",
    "seed": "tsx prisma/seed.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
